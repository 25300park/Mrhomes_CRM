# ═══════════════════════════════════════
# RBS Homes CRM · 환경변수 설정
# .env.example → .env 로 복사 후 값 입력
# ═══════════════════════════════════════

# Supabase (https://supabase.com → 프로젝트 설정 → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here   # Settings > API > service_role

# JWT 시크릿 (랜덤 32자 이상 문자열)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Required on Railway/production. Canonical UTC ISO-8601 rollout instant.
# Tokens issued before this instant are rejected, forcing every user to sign in again.
AUTH_INVALID_BEFORE=2026-07-16T09:00:00.000Z

# 서버 포트
PORT=4000

# Disable scheduled jobs in one-off or test server processes.
SCHEDULER_ENABLED=true

# Optional AI review adapter. Jobs fail safely and retry when this is unset.
OPENAI_API_KEY=
TIME_AI_REVIEW_MODEL=gpt-4.1-mini
TIME_JOB_POLL_MS=60000
TIME_JOB_WORKER_ID=

# Web Push uses VAPID. Generate these once and keep the private values server-only.
VAPID_SUBJECT=mailto:ops@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Keyring entries are comma-separated key-id=canonical-base64 pairs; every key is exactly 32 bytes.
# New subscriptions use ACTIVE_KEY_ID. Keep old entries until all matching v1:key-id ciphertext is migrated.
# Rotate by adding a new entry, changing ACTIVE_KEY_ID, re-saving/migrating subscriptions, then retiring the old entry.
TIME_PUSH_ACTIVE_KEY_ID=current
TIME_PUSH_ENCRYPTION_KEYS=current=
# Legacy four-part v1 envelopes have no key id. List candidate key ids in deterministic trial order during migration.
TIME_PUSH_LEGACY_KEY_IDS=current

# Legacy single-origin compatibility input. Prefer ALLOWED_ORIGINS below.
FRONTEND_URL=http://localhost:4000

# Comma-separated browser origins allowed to call this service with credentials.
# Requests without an Origin header (same-origin/server clients) remain allowed.
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173
